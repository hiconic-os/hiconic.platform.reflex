<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>tribefire Login</title>
<meta name="viewport" content="initial-scale=1, width=device-width, maximum-scale=1, minimum-scale=1, user-scalable=no">
<style>
div.loginContent {
	margin: 0;
	padding: 0;
	background-color: white;
	background-repeat: no-repeat;
	background-position: 100% 100%;
	height: 100%;
	min-height: 100%;
	font-family: 'Open Sans', sans-serif;
	font-weight: 300;
	font-size: medium;
	color: gray;
	font-smoothing: antialiased;
	-webkit-font-smoothing: antialiased;
	text-shadow: 1px 1px 1px rgba(0,0,0,0.004);
	text-align: center;
}
*.loginContent input, *.loginContent textarea, *.loginContent button {
	font-family: 'Open Sans', sans-serif;
	font-weight: 300;
	font-size: medium;
	outline: none;
	box-sizing: border-box;
	-moz-box-sizing: border-box;
}
*.loginContent img {
	margin-top: 100px;
}
*.loginContent h1 {
	margin: 0px auto 20px auto;
	padding: 100px 0 0 0;
	font-size: 24px;
	color: orange;
}
form.loginForm {
	position: relative;
	width: 210px;
	margin: 20px auto 0 auto;
	padding: 50px;
	background-color: rgba(0,0,0,0.05);
}
form.loginForm.loginFormBusy {
	cursor: wait;
}
form.loginForm .loginBusyMask {
	position: absolute;
	inset: 0;
	z-index: 10;
	display: flex;
	align-items: center;
	justify-content: center;
	margin: 0;
	background: rgba(255, 255, 255, 0.86);
	opacity: 0;
	visibility: hidden;
	pointer-events: none;
	transition: opacity 180ms ease, visibility 0s linear 180ms;
}
form.loginForm.loginFormBusy .loginBusyMask {
	pointer-events: auto;
}
form.loginForm .loginBusyMask.loginBusyMaskVisible {
	opacity: 1;
	visibility: visible;
	transition: opacity 180ms ease;
}
form.loginForm .loginBusyIndicator {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 12px;
	margin: 0;
	color: #666;
}
form.loginForm .loginBusySpinner {
	width: 28px;
	height: 28px;
	border: 3px solid rgba(255, 165, 0, 0.25);
	border-top-color: #ffa500;
	border-radius: 50%;
	animation: loginBusySpin 700ms linear infinite;
}
@keyframes loginBusySpin {
	to { transform: rotate(360deg); }
}
@media (prefers-reduced-motion: reduce) {
	form.loginForm .loginBusyMask {
		transition-duration: 1ms;
	}
	form.loginForm .loginBusySpinner {
		animation-duration: 1400ms;
	}
}
*.loginContent div {
	margin-bottom: 15px;
}
*.loginContent input[type="text"], *.loginContent input[type="password"] {
	width: 100% !important;
	padding: 10px !important;
	height: 35px !important;
	border: 0;
	background-color: white;
	color: gray;
	border-radius: 0px;
}
*.loginContent input[type="checkbox"] {
	height: 12px;
	width: 12px;
}
*.loginContent button {
	padding: 5px 30px !important;
	font-size: 16px !important;
	background-color: #ffa500 !important;
	border: 0 !important;
	cursor: pointer !important;
	height: 35px !important;
	width: 100% !important;
	color: white;
}
*.loginContent .errorMessage {
	font-size: small;
	color: red;
}
*.loginContent .okMessage {
	font-size: small;
	color: green;
}
.mycheckbox {
	width: 10px;
	height: 10px;
	margin-top: 5px;
}
</style>



<script>

var busyRevealTimer;

function bindForm() {
 var form = document.getElementById("signinForm");
 form.addEventListener("submit", function (event) {
   event.preventDefault();
   login();
 });

 document.getElementById("loginAction").addEventListener("click", function () {
	var action = this.getAttribute("data-action");
	if (action) login(action);
 });

}

function login(action) {

	var loginData = new Object();
	loginData.user = document.getElementById("input_user").value;
	loginData.password = document.getElementById("input_password").value;
	#if($offerStaySigned)
	loginData.staySignedIn = document.getElementById("staySigned").checked;
	#end

    var loginDataJson= JSON.stringify(loginData);
	
	var request = new XMLHttpRequest();
	
 	// Set up our request
 	request.open('POST', 'login/auth');
	request.setRequestHeader("Content-Type","application/json");
	request.setRequestHeader("Accept","application/json");
	if (action) request.setRequestHeader("X-Hiconic-Login-Action", action);
	setBusy(true);
	
	// Define repsonse handling
	request.onreadystatechange = function () {
		
		if(request.readyState == 4) {
			var interventionState = request.getResponseHeader("X-Hiconic-Login-Intervention-State");
			if (interventionState == "RETRY_AUTHENTICATION") {
				login();
				return;
			}
			if (interventionState) {
				setBusy(false);
				renderIntervention(request, interventionState);
				return;
			}

			if (request.status == 200) {
				var sessionId = request.responseText;
				
				var redirectLocation = "."; // default redirect to current page
				#if ($continue)
					redirectLocation = '$continue';
				#end
				
				window.location = redirectLocation; // redirect to landing page
			} else {
				setBusy(false);
				var failureMessage = "Could not sign in";
				try {
					var failure = JSON.parse(request.responseText);
					var type = failure._type;
					if (failure.text && failure.text.length > 0) {
						failureMessage = failure.text;
					}
					if (type == 'com.braintribe.gm.model.security.reason.SecondFactorRequired') {
						failureMessage = "Please verify your login with the token sent to you separately.";
						var redirectUrl = failure.redirectUrl;
						if (redirectUrl && redirectUrl.length > 0) {
							window.location = redirectUrl;
							return;
						}			
					}
				
				} catch (err) {
					console.log("Could not parse response text");
				}	
				renderMessage("Sign in failed", failureMessage, null, null);
			}
			
		}
	
	}
	
 	// Send login request
 	request.send(loginDataJson);
	//request.send();
}

function renderIntervention(request, state) {
	var title = request.getResponseHeader("X-Hiconic-Login-Intervention-Title") || "Additional verification required";
	var message = request.getResponseHeader("X-Hiconic-Login-Intervention-Message") || "Please complete the required verification.";
	var action = request.getResponseHeader("X-Hiconic-Login-Intervention-Action");
	var actionLabel = request.getResponseHeader("X-Hiconic-Login-Intervention-Action-Label");
	renderMessage(title, message, action, actionLabel);
}

function renderMessage(title, message, action, actionLabel) {
	document.getElementById("loginMessageTitle").textContent = title || "";
	document.getElementById("loginMessageText").textContent = message || "";
	var actionButton = document.getElementById("loginAction");
	if (action && actionLabel) {
		actionButton.textContent = actionLabel;
		actionButton.setAttribute("data-action", action);
		actionButton.style.display = "inline-block";
	} else {
		actionButton.removeAttribute("data-action");
		actionButton.style.display = "none";
	}
}

function setBusy(busy) {
	var form = document.getElementById("signinForm");
	var mask = document.getElementById("loginBusyMask");
	clearTimeout(busyRevealTimer);

	form.classList.toggle("loginFormBusy", busy);
	form.setAttribute("aria-busy", busy ? "true" : "false");
	document.getElementById("signInButton").disabled = busy;
	document.getElementById("loginAction").disabled = busy;
	document.getElementById("input_user").readOnly = busy;
	document.getElementById("input_password").readOnly = busy;
	#if($offerStaySigned)
	document.getElementById("staySigned").disabled = busy;
	#end

	if (busy) {
		busyRevealTimer = setTimeout(function () {
			mask.classList.add("loginBusyMaskVisible");
			mask.setAttribute("aria-hidden", "false");
		}, 150);
	} else {
		mask.classList.remove("loginBusyMaskVisible");
		mask.setAttribute("aria-hidden", "true");
	}
}

</script>

</head>
<body onLoad="bindForm()">

  <div class="loginContent">
	<h1>Welcome</h1>
	
	<form id="signinForm" class="loginForm" accept-charset="UTF-8">
			<div id="loginBusyMask" class="loginBusyMask" aria-hidden="true">
				<div class="loginBusyIndicator" role="status" aria-live="polite">
					<span class="loginBusySpinner" aria-hidden="true"></span>
					<span>Signing in&hellip;</span>
				</div>
			</div>
			<div>				
				<input id="input_user" type="text" name="user" placeholder="Username" autofocus>
			</div>
			<div>
				<input id="input_password" type="password" name="password" placeholder="Password">
			</div>
			<div>
				<button id="signInButton" type="submit">Sign in</button>
			</div>
			#if($offerStaySigned)
			<div>
				<input id="staySigned" type="checkbox" name="staySigned" checked="checked" value="true" class="mycheckbox" />
				<span style="font-size:12px">Stay signed in</span>
			</div>
			#end

			<div>
				#if ($messageStatus == "OK")
					<div class="okMessage" align="center">
				#else
					<div class="errorMessage" align="center">
				#end
					<strong id="loginMessageTitle"></strong>
					<span id="loginMessageText">
						#if($message)$tools.escape($message)#else&nbsp;#end
					</span>
					<button id="loginAction" type="button" style="display:none"></button>
				</div>
			</div>
			
			#if ($continue)
				<input type="hidden" name="continue" value="$tools.escape($continue)" />
			#end
	</form>
  </div>
  

</body>
</html>
