<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>tribefire Login</title>
<meta name="viewport" content="initial-scale=1, width=device-width, maximum-scale=1, minimum-scale=1, user-scalable=no">
<style>
html, body {
	min-height: 100%;
	margin: 0;
}
body {
	background: #f5f7fa;
}
div.loginContent {
	min-height: 100vh;
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	padding: 32px 16px;
	font-family: 'Open Sans', sans-serif;
	font-weight: 400;
	font-size: 16px;
	color: #283341;
	-webkit-font-smoothing: antialiased;
}
.loginPanel {
	width: min(100%, 420px);
}
*.loginContent input, *.loginContent button {
	font-family: 'Open Sans', sans-serif;
	font-size: 15px;
	box-sizing: border-box;
}
*.loginContent h1 {
	margin: 0 0 8px;
	font-size: 28px;
	font-weight: 600;
	letter-spacing: -0.02em;
	color: #1f2937;
	text-align: center;
}
.loginSubtitle {
	margin: 0 0 24px;
	color: #6b7280;
	font-size: 14px;
	line-height: 1.5;
	text-align: center;
}
form.loginForm {
	position: relative;
	box-sizing: border-box;
	width: 100%;
	margin: 0;
	padding: 32px;
	background: #fff;
	border: 1px solid #e2e8f0;
	border-radius: 14px;
	box-shadow: 0 16px 40px rgba(15, 23, 42, 0.10);
	overflow: hidden;
	animation: loginAppear 180ms ease-out;
}
form.loginForm.loginFormBusy {
	cursor: wait;
}
form.loginForm .loginBusyMask {
	position: absolute;
	inset: 0;
	z-index: 10;
	display: flex;
	align-items: center;
	justify-content: center;
	margin: 0;
	background: rgba(255, 255, 255, 0.90);
	backdrop-filter: blur(2px);
	opacity: 0;
	visibility: hidden;
	pointer-events: none;
	transition: opacity 180ms ease, visibility 0s linear 180ms;
}
form.loginForm.loginFormBusy .loginBusyMask {
	pointer-events: auto;
}
form.loginForm .loginBusyMask.loginBusyMaskVisible {
	opacity: 1;
	visibility: visible;
	transition: opacity 180ms ease;
}
form.loginForm .loginBusyIndicator {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 12px;
	margin: 0;
	color: #475569;
	font-size: 14px;
	font-weight: 500;
}
form.loginForm .loginBusySpinner {
	width: 28px;
	height: 28px;
	border: 3px solid rgba(255, 165, 0, 0.25);
	border-top-color: #ffa500;
	border-radius: 50%;
	animation: loginBusySpin 700ms linear infinite;
}
@keyframes loginAppear {
	from { opacity: 0; transform: translateY(4px); }
	to { opacity: 1; transform: translateY(0); }
}
@keyframes loginBusySpin {
	to { transform: rotate(360deg); }
}
@media (prefers-reduced-motion: reduce) {
	form.loginForm .loginBusyMask {
		transition-duration: 1ms;
	}
	form.loginForm, form.loginForm .loginBusyMask { animation: none; transition: none; }
}
.loginField {
	margin-bottom: 14px;
}
*.loginContent input[type="text"], *.loginContent input[type="password"] {
	width: 100%;
	height: 44px;
	padding: 0 13px;
	border: 1px solid #cbd5e1;
	border-radius: 8px;
	background: #fff;
	color: #1f2937;
	transition: border-color 120ms ease, box-shadow 120ms ease;
}
*.loginContent input[type="text"]:focus, *.loginContent input[type="password"]:focus {
	border-color: #f59e0b;
	box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.16);
	outline: none;
}
*.loginContent input[type="checkbox"] {
	height: 15px;
	width: 15px;
	accent-color: #f59e0b;
}
*.loginContent button {
	width: 100%;
	min-height: 44px;
	padding: 9px 16px;
	border: 1px solid #e69000;
	border-radius: 8px;
	background: #f59e0b;
	font-weight: 600;
	color: white;
	cursor: pointer;
	transition: background-color 120ms ease, box-shadow 120ms ease, transform 80ms ease;
}
*.loginContent button:hover:not(:disabled) {
	background: #e69000;
}
*.loginContent button:focus-visible, *.loginContent a.loginOption:focus-visible {
	outline: 3px solid rgba(245, 158, 11, 0.28);
	outline-offset: 2px;
}
*.loginContent button:active:not(:disabled) {
	transform: translateY(1px);
}
*.loginContent button:disabled {
	opacity: 0.58;
	cursor: not-allowed;
}
.loginStaySigned {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 7px;
	margin: 2px 0 18px;
	font-size: 13px;
	color: #64748b;
}
*.loginContent a.loginOption {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 10px;
	box-sizing: border-box;
	width: 100%;
	min-height: 44px;
	padding: 8px 12px;
	background-color: white;
	color: #334155;
	text-decoration: none;
	font-weight: 600;
	border: 1px solid #cbd5e1;
	border-radius: 8px;
	transition: border-color 120ms ease, background-color 120ms ease;
}
*.loginContent a.loginOption:hover {
	border-color: #f59e0b;
	background: #fffbeb;
}
*.loginContent a.loginOption img {
	width: 24px;
	height: 24px;
	margin: 0;
	object-fit: contain;
}
.loginMessage {
	display: block;
	box-sizing: border-box;
	margin: 18px 0;
	padding: 12px 14px;
	border: 1px solid #fecaca;
	border-radius: 8px;
	background: #fff7f7;
	color: #9f1239;
	font-size: 14px;
	line-height: 1.45;
	text-align: left;
	overflow-wrap: anywhere;
}
.loginMessage[hidden] {
	display: none;
}
.loginMessageTitle {
	display: block;
	margin-bottom: 3px;
	font-weight: 700;
	color: #881337;
}
.loginMessageText {
	display: block;
}
.loginMessageOk {
	border-color: #bbf7d0;
	background: #f0fdf4;
	color: #166534;
}
.loginMessageOk .loginMessageTitle {
	color: #14532d;
}
.loginMessageAction {
	margin-top: 12px;
}
.loginOptionRow {
	margin-top: 12px;
}
.loginDivider {
	display: flex;
	align-items: center;
	gap: 12px;
	margin: 20px 0 8px;
	color: #94a3b8;
	font-size: 12px;
	text-transform: uppercase;
	letter-spacing: 0.08em;
}
.loginDivider::before, .loginDivider::after {
	content: "";
	flex: 1;
	height: 1px;
	background: #e2e8f0;
}
@media (max-width: 480px) {
	div.loginContent { align-items: flex-start; padding: 20px 12px; }
	form.loginForm { padding: 24px 20px; }
}
</style>



<script>

var busyRevealTimer;

function bindForm() {
	#if($localLoginEnabled)
	var form = document.getElementById("signinForm");
	form.addEventListener("submit", function (event) {
		event.preventDefault();
		login();
	});

	#end
	document.getElementById("loginAction").addEventListener("click", function () {
		var actionUrl = this.getAttribute("data-action-url");
		if (actionUrl) {
			window.location = actionUrl;
			return;
		}
		var action = this.getAttribute("data-action");
		if (action) login(action);
	});
	document.querySelectorAll("a.loginOption").forEach(function (option) {
		option.addEventListener("click", function () { setBusy(true, "Continuing to sign in…"); });
	});
}

function login(action) {

	var loginData = new Object();
	loginData.user = document.getElementById("input_user").value;
	loginData.password = document.getElementById("input_password").value;
	#if($offerStaySigned)
	loginData.staySignedIn = document.getElementById("staySigned").checked;
	#end

    var loginDataJson= JSON.stringify(loginData);
	
	var request = new XMLHttpRequest();
	
 	// Set up our request
 	request.open('POST', 'login/auth');
	request.setRequestHeader("Content-Type","application/json");
	request.setRequestHeader("Accept","application/json");
	if (action) request.setRequestHeader("X-Hiconic-Login-Action", action);
	setBusy(true);
	
	// Define repsonse handling
	request.onreadystatechange = function () {
		
		if(request.readyState == 4) {
			var interventionState = request.getResponseHeader("X-Hiconic-Login-Intervention-State");
			if (interventionState == "RETRY_AUTHENTICATION") {
				login();
				return;
			}
			if (interventionState) {
				setBusy(false);
				renderIntervention(request, interventionState);
				return;
			}

			if (request.status == 200) {
				var sessionId = request.responseText;
				
				var redirectLocation = "."; // default redirect to current page
				#if ($continue)
					redirectLocation = '$continue';
				#end
				
				window.location = redirectLocation; // redirect to landing page
			} else {
				setBusy(false);
				var failureMessage = "Could not sign in";
				try {
					var failure = JSON.parse(request.responseText);
					var type = failure._type;
					if (failure.text && failure.text.length > 0) {
						failureMessage = failure.text;
					}
					if (type == 'com.braintribe.gm.model.security.reason.SecondFactorRequired') {
						failureMessage = "Please verify your login with the token sent to you separately.";
						var redirectUrl = failure.redirectUrl;
						if (redirectUrl && redirectUrl.length > 0) {
							window.location = redirectUrl;
							return;
						}			
					}
				
				} catch (err) {
					console.log("Could not parse response text");
				}	
				renderMessage("Sign in failed", failureMessage, null, null);
			}
			
		}
	
	}
	
 	// Send login request
 	request.send(loginDataJson);
	//request.send();
}

function renderIntervention(request, state) {
	var title = request.getResponseHeader("X-Hiconic-Login-Intervention-Title") || "Additional verification required";
	var message = request.getResponseHeader("X-Hiconic-Login-Intervention-Message") || "Please complete the required verification.";
	var action = request.getResponseHeader("X-Hiconic-Login-Intervention-Action");
	var actionLabel = request.getResponseHeader("X-Hiconic-Login-Intervention-Action-Label");
	renderMessage(title, message, action, actionLabel);
}

function renderMessage(title, message, action, actionLabel) {
	var messageBox = document.getElementById("loginMessage");
	messageBox.hidden = false;
	messageBox.classList.remove("loginMessageOk");
	document.getElementById("loginMessageTitle").textContent = title || "";
	document.getElementById("loginMessageText").textContent = message || "";
	var actionButton = document.getElementById("loginAction");
	if (action && actionLabel) {
		actionButton.textContent = actionLabel;
		actionButton.setAttribute("data-action", action);
		actionButton.removeAttribute("data-action-url");
		actionButton.style.display = "inline-block";
	} else {
		actionButton.removeAttribute("data-action");
		actionButton.style.display = "none";
	}
}

function setBusy(busy, label) {
	var form = document.getElementById("signinForm");
	var mask = document.getElementById("loginBusyMask");
	clearTimeout(busyRevealTimer);

	form.classList.toggle("loginFormBusy", busy);
	form.setAttribute("aria-busy", busy ? "true" : "false");
	var busyLabel = document.getElementById("loginBusyLabel");
	if (busyLabel) busyLabel.textContent = label || "Signing in…";
	var signInButton = document.getElementById("signInButton");
	if (signInButton) signInButton.disabled = busy;
	var loginAction = document.getElementById("loginAction");
	if (loginAction) loginAction.disabled = busy;
	var userInput = document.getElementById("input_user");
	if (userInput) userInput.readOnly = busy;
	var passwordInput = document.getElementById("input_password");
	if (passwordInput) passwordInput.readOnly = busy;
	#if($offerStaySigned)
	var staySigned = document.getElementById("staySigned");
	if (staySigned) staySigned.disabled = busy;
	#end

	if (busy) {
		busyRevealTimer = setTimeout(function () {
			mask.classList.add("loginBusyMaskVisible");
			mask.setAttribute("aria-hidden", "false");
		}, 150);
	} else {
		mask.classList.remove("loginBusyMaskVisible");
		mask.setAttribute("aria-hidden", "true");
	}
}

</script>

</head>
<body onLoad="bindForm()">

  <div class="loginContent">
	<div class="loginPanel">
		<h1>Welcome</h1>
		<p class="loginSubtitle">Sign in to continue.</p>
		<form id="signinForm" class="loginForm" accept-charset="UTF-8">
			<div id="loginBusyMask" class="loginBusyMask" aria-hidden="true">
				<div class="loginBusyIndicator" role="status" aria-live="polite">
					<span class="loginBusySpinner" aria-hidden="true"></span>
					<span id="loginBusyLabel">Signing in&hellip;</span>
				</div>
			</div>
			#if($localLoginEnabled)
			<div class="loginField">
				<input id="input_user" type="text" name="user" placeholder="Username" autofocus>
			</div>
			<div class="loginField">
				<input id="input_password" type="password" name="password" placeholder="Password">
			</div>
			<div class="loginField">
				<button id="signInButton" type="submit">Sign in</button>
			</div>
			#if($offerStaySigned)
			<div class="loginStaySigned">
				<input id="staySigned" type="checkbox" name="staySigned" checked="checked" value="true" />
				<label for="staySigned">Stay signed in</label>
			</div>
			#end
			#end

			<div id="loginMessage" role="alert" aria-live="polite"
				class="loginMessage#if($messageStatus == 'OK') loginMessageOk#end"
				#if(!$interventionTitle && !$interventionMessage && !$message) hidden#end>
				<strong id="loginMessageTitle" class="loginMessageTitle">#if($interventionTitle)$tools.escape($interventionTitle)#elseif($message)Sign in failed#end</strong>
				<span id="loginMessageText" class="loginMessageText">
					#if($interventionMessage)$tools.escape($interventionMessage)#elseif($message)$tools.escape($message)#end
				</span>
				<button id="loginAction" class="loginMessageAction" type="button"
						#if($interventionActionUrl) data-action-url="$tools.escape($interventionActionUrl)"#elseif($interventionAction) data-action="$tools.escape($interventionAction)"#end
						#if(!$interventionAction || !$interventionActionLabel) style="display:none"#end>#if($interventionActionLabel)$tools.escape($interventionActionLabel)#end</button>
			</div>

			#if($loginOptions && !$loginOptions.isEmpty())
				#if($localLoginEnabled)<div class="loginDivider"><span>or</span></div>#end
				#foreach($loginOption in $loginOptions)
				<div class="loginOptionRow">
					<a id="loginOption-$tools.escape($loginOption.id)" class="loginOption" href="$tools.escape($loginOption.url)">
						#if($loginOption.iconPath)
							<img src="$tools.escape($loginOption.iconPath)" alt="">
						#end
						<span>Sign in with $tools.escape($loginOption.label)</span>
					</a>
				</div>
				#end
			#elseif(!$localLoginEnabled && !$externalIntervention)
				<div class="loginMessage">No login method is configured.</div>
			#end
			
			#if ($continue)
				<input type="hidden" name="continue" value="$tools.escape($continue)" />
			#end
		</form>
	</div>
  </div>
  

</body>
</html>
