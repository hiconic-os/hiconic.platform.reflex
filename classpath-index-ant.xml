<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project name="classpath-index">
	<target name="generate-classpath-index">
		<mkdir dir="build/META-INF"/>
		<delete file="src/META-INF/classpath-index.txt" quiet="true"/>
		<delete file="src/META-INF/classpath-resource-only" quiet="true"/>
		<delete file="build/META-INF/classpath-resource-only" quiet="true"/>
		<pathconvert property="classpath.index.entries" pathsep="${line.separator}" targetos="unix">
			<fileset dir="src">
				<include name="**/*"/>
				<exclude name="**/*.java"/>
				<exclude name="**/.gitignore"/>
				<exclude name="META-INF/classpath-index.txt"/>
				<exclude name="META-INF/classpath-resource-only"/>
			</fileset>
			<map from="${basedir}/src/" to=""/>
		</pathconvert>
		<echo file="build/META-INF/classpath-index.txt">${classpath.index.entries}${line.separator}</echo>
	</target>

	<!-- Devrock always contributes class-gen to the Eclipse classpath. Keeping the
	     generated index there avoids source-tree changes and recursive builds. -->
	<target name="prepare-eclipse-classpath-index">
		<property name="eclipse.output.dir" value="class-gen"/>
		<mkdir dir="${eclipse.output.dir}/META-INF"/>
		<tempfile property="eclipse.classpath.index.tmp" destdir="${java.io.tmpdir}" prefix="classpath-index-" suffix=".txt" deleteonexit="true"/>
		<pathconvert property="classpath.index.entries" pathsep="${line.separator}" targetos="unix">
			<fileset dir="src">
				<include name="**/*"/>
				<exclude name="**/*.java"/>
				<exclude name="**/.gitignore"/>
				<exclude name="META-INF/classpath-index.txt"/>
				<exclude name="META-INF/classpath-resource-only"/>
			</fileset>
			<map from="${basedir}/src/" to=""/>
		</pathconvert>
		<echo file="${eclipse.classpath.index.tmp}">${classpath.index.entries}${line.separator}</echo>
		<condition property="eclipse.classpath.index.unchanged">
			<and>
				<available file="${eclipse.output.dir}/META-INF/classpath-index.txt"/>
				<filesmatch file1="${eclipse.output.dir}/META-INF/classpath-index.txt" file2="${eclipse.classpath.index.tmp}"/>
			</and>
		</condition>
	</target>

	<!-- Avoid timestamp-only workspace deltas which recursively schedule the incremental builder. -->
	<target name="update-eclipse-classpath-index" depends="prepare-eclipse-classpath-index" unless="eclipse.classpath.index.unchanged">
		<copy file="${eclipse.classpath.index.tmp}" tofile="${eclipse.output.dir}/META-INF/classpath-index.txt" overwrite="true"/>
	</target>

	<target name="generate-eclipse-classpath-index" depends="update-eclipse-classpath-index">
		<delete file="${eclipse.classpath.index.tmp}" quiet="true"/>
	</target>

	<target name="generate-pure-classpath-index" depends="generate-classpath-index">
		<resourcecount property="pure.classpath.forbidden.count">
			<fileset dir="src">
				<include name="**/*.java"/>
				<include name="**/*.class"/>
				<include name="**/*.jar"/>
				<include name="**/*.so"/>
				<include name="**/*.dll"/>
				<include name="**/*.dylib"/>
				<include name="META-INF/services/**"/>
			</fileset>
		</resourcecount>
		<fail message="A pure classpath resource artifact contains executable or nested runtime content.">
			<condition>
				<not><equals arg1="${pure.classpath.forbidden.count}" arg2="0"/></not>
			</condition>
		</fail>
	</target>

	<target name="mark-pure-classpath-resource" depends="generate-pure-classpath-index">
		<mkdir dir="build/META-INF"/>
		<echo file="build/META-INF/classpath-resource-only">formatVersion=1${line.separator}</echo>
	</target>
</project>
